#!/usr/bin/env python3
import argparse, datetime, fnmatch, json, os, re, shutil, subprocess, sys
from pathlib import Path
from urllib.parse import urlparse, unquote

HOME = Path(os.environ.get('LLAMA_HOME', str(Path.home())))
INI = Path(os.environ.get('LLAMA_MODELS_INI', str(HOME / 'llama-models.ini')))
MODELS_DIR = Path(os.environ.get('LLAMA_MODELS_DIR', '/models-local'))
REPO = Path(os.environ.get('LLAMA_CPP_DIR', str(HOME / 'llama.cpp')))
BUILD = REPO / 'build-all'
SERVER = BUILD / 'bin/llama-server'
STATE = Path(os.environ.get('LLAMA_MODELCTL_STATE', str(HOME / '.config/llama-modelctl/state.json')))
SERVICE = os.environ.get('LLAMA_SERVICE', 'llama-main')

PROTECTED = {'device','fit-target','n-gpu-layers','main-gpu','split-mode','fit'}
CACHE_KEYS = {'cache-type-k','cache-type-v','cache-type-k-draft','cache-type-v-draft'}
CACHE_TYPES = {'f32','f16','bf16','q8_0','q5_0','q5_1','q4_0','q4_1','iq4_nl'}
BACKEND_MODES = {'auto','cuda','hip','rocm','vulkan','cpu'}
PERF_PROFILES = {'balanced','throughput','capacity'}
SAMPLING_PRESETS = {
    'precise': {'temp':'0.2','top-p':'0.9','top-k':'20','min-p':'0.0','presence-penalty':'0.0','repeat-penalty':'1.0'},
    'coding-agent': {'temp':'0.3','top-p':'0.9','top-k':'20','min-p':'0.0','presence-penalty':'0.0','repeat-penalty':'1.0'},
    'general-agent': {'temp':'0.7','top-p':'0.9','top-k':'20','min-p':'0.0','presence-penalty':'0.0','repeat-penalty':'1.0'},
    'creative': {'temp':'1.0','top-p':'0.95','top-k':'50','min-p':'0.0','presence-penalty':'0.2','repeat-penalty':'1.0'},
}
SAMPLING_KEYS = {'temp','top-p','top-k','min-p','presence-penalty','repeat-penalty'}


def die(msg):
    print(f'ERROR: {msg}', file=sys.stderr); raise SystemExit(1)

def run(cmd, *, capture=False, check=True, cwd=None):
    print('+', ' '.join(map(str, cmd)))
    return subprocess.run(list(map(str, cmd)), text=True, cwd=cwd,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None, check=check)

def load_state():
    if not STATE.exists(): return {'models': {}}
    try: return json.loads(STATE.read_text(encoding='utf-8'))
    except Exception as e: die(f'invalid state {STATE}: {e}')

def save_state(st):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix('.tmp')
    tmp.write_text(json.dumps(st, indent=2, sort_keys=True) + '\n', encoding='utf-8')
    os.replace(tmp, STATE)

def backup_ini():
    if not INI.exists(): die(f'{INI} not found')
    ts = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
    dst = INI.with_name(INI.name + '.bak.' + ts)
    shutil.copy2(INI, dst); print('Backup:', dst)

def read_ini():
    if not INI.exists(): die(f'{INI} not found')
    return INI.read_text(encoding='utf-8')

def section_re(name): return re.compile(rf'(?ms)^\[{re.escape(name)}\]\s*\n.*?(?=^\[|\Z)')
def get_section(txt, name):
    m=section_re(name).search(txt); return m.group(0).rstrip() if m else None

def set_section(txt, name, block):
    txt=section_re(name).sub('',txt).rstrip(); return txt+'\n\n'+block.strip()+'\n'
def remove_section(txt, name): return section_re(name).sub('',txt).rstrip()+'\n'
def values(sec):
    d={}
    for line in sec.splitlines()[1:]:
        m=re.match(r'^\s*([A-Za-z0-9_-]+)\s*=\s*(.*?)\s*$',line)
        if m: d[m.group(1).lower()]=m.group(2)
    return d

def set_key(txt,name,key,val):
    sec=get_section(txt,name)
    if not sec: die(f'profile not found: {name}')
    out=[sec.splitlines()[0]]; done=False
    for line in sec.splitlines()[1:]:
        m=re.match(r'^\s*([A-Za-z0-9_-]+)\s*=',line)
        if m and m.group(1).lower()==key.lower(): out.append(f'{key} = {val}'); done=True
        else: out.append(line)
    if not done: out.append(f'{key} = {val}')
    return section_re(name).sub('\n'.join(out)+'\n',txt)
def unset_key(txt,name,key):
    sec=get_section(txt,name)
    if not sec: die(f'profile not found: {name}')
    out=[]
    for line in sec.splitlines():
        m=re.match(r'^\s*([A-Za-z0-9_-]+)\s*=',line)
        if m and m.group(1).lower()==key.lower(): continue
        out.append(line)
    return section_re(name).sub('\n'.join(out)+'\n',txt)

def restart():
    u=subprocess.run(['systemctl','--user','cat',SERVICE+'.service'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if u.returncode==0:
        run(['systemctl','--user','restart',SERVICE]); return
    s=subprocess.run(['systemctl','cat',SERVICE+'.service'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if s.returncode==0:
        run(['sudo','systemctl','restart',SERVICE]); return
    print(f'WARNING: {SERVICE} not found; restart skipped', file=sys.stderr)

def parse_hf(src):
    if src.startswith('hf://'):
        p=src[5:].split('/',2)
        if len(p)<2: die('invalid hf:// URL')
        return '/'.join(p[:2]), 'main', p[2] if len(p)>2 else None
    if src.startswith('http://') or src.startswith('https://'):
        u=urlparse(src)
        if u.netloc not in {'huggingface.co','www.huggingface.co'}: return None
        p=[unquote(x) for x in u.path.strip('/').split('/')]
        if len(p)<2: die('invalid Hugging Face URL')
        repo=f'{p[0]}/{p[1]}'
        if len(p)>=5 and p[2] in {'blob','resolve'}: return repo,p[3],'/'.join(p[4:])
        return repo,'main',None
    if re.match(r'^[^/\s]+/[^/\s]+$',src): return src,'main',None
    return None

def hf_files(repo, rev):
    try:
        from huggingface_hub import HfApi
    except ImportError: die('install huggingface_hub: python3 -m pip install --user -U huggingface_hub')
    try: return HfApi().list_repo_files(repo_id=repo, revision=rev)
    except Exception as e: die(f'cannot list {repo}@{rev}: {e}')
def choose(files, wanted):
    c=[f for f in files if f.lower().endswith('.gguf') and 'mmproj' not in f.lower()]
    if wanted:
        m=[f for f in c if f==wanted or fnmatch.fnmatch(f,wanted)]
        if len(m)==1: return m[0]
        if len(m)>1: die('multiple GGUF matches; use a more precise --file')
        die(f'GGUF not found: {wanted}')
    if len(c)==1: return c[0]
    print('\n'.join(c[:80])); die('repo contains multiple GGUF files; use --file')
def shards(files, f):
    m=re.match(r'^(.*)-(\d{5})-of-(\d{5})\.gguf$',f)
    if not m: return [f]
    rx=re.compile(rf'^{re.escape(m.group(1))}-\d{{5}}-of-{m.group(3)}\.gguf$')
    return sorted(x for x in files if rx.match(x)) or [f]
def mmproj(files):
    c=[f for f in files if f.lower().endswith('.gguf') and 'mmproj' in f.lower()]
    if not c: return None
    def rank(x):
        l=x.lower(); return (0 if 'q8_0' in l else 1 if 'bf16' in l else 2 if 'f16' in l else 9, x)
    return sorted(c,key=rank)[0]
def hf_download(repo, rev, files, dst):
    if not shutil.which('hf'): die("'hf' command missing; install huggingface_hub")
    run(['hf','download',repo,*files,'--revision',rev,'--local-dir',dst])

def default_block(name, model, mm=None):
    low=(name+' '+model.name).lower()
    b=[f'[{name}]',f'model = {model}',f'alias = {name}']
    if mm: b.append(f'mmproj = {mm}')
    b += ['', 'parallel = 1','batch-size = 512','ubatch-size = 256','','jinja = true','cont-batching = true','flash-attn = on','','cache-type-k = f16','cache-type-v = f16','']
    if 'qwen3.8' in low or 'qwen38' in low:
        b += ['reasoning = off','reasoning-preserve = false','spec-type = none','','temp = 0.7','top-p = 0.8','top-k = 20','min-p = 0.0','presence-penalty = 1.5','repeat-penalty = 1.0']
    else: b += ['reasoning = off','spec-type = none']
    b += ['','n-predict = 8192','load-on-startup = false']
    return '\n'.join(b)

def cmd_list(a):
    txt=read_ini()
    for n in re.findall(r'(?m)^\[([^]]+)\]\s*$',txt):
        if n=='*': continue
        v=values(get_section(txt,n)); st=load_state().get('models',{}).get(n,{})
        cm=st.get('ctx_mode','legacy'); cv=st.get('ctx_size',st.get('fit_ctx',''))
        print(f'{n:45} ctx={cm}:{cv}  {v.get("model","")}')
def cmd_show(a):
    s=get_section(read_ini(),a.name)
    if not s: die('profile not found')
    print(s); print('\n--- modelctl state ---'); print(json.dumps(load_state().get('models',{}).get(a.name,{}),indent=2))
def cmd_add(a):
    MODELS_DIR.mkdir(parents=True,exist_ok=True)
    if not os.access(MODELS_DIR,os.W_OK): die(f'{MODELS_DIR} not writable; sudo chown $USER:$USER {MODELS_DIR}')
    src=Path(os.path.expanduser(a.source)); mm=None
    if src.is_file():
        dst=MODELS_DIR/a.name; dst.mkdir(parents=True,exist_ok=True); model=dst/src.name
        if src.resolve()!=model.resolve(): shutil.copy2(src,model)
        if a.mmproj:
            mp=Path(os.path.expanduser(a.mmproj));
            if not mp.is_file(): die('mmproj not found')
            mm=dst/mp.name
            if mp.resolve()!=mm.resolve(): shutil.copy2(mp,mm)
    else:
        p=parse_hf(a.source)
        if not p: die('source must be a local GGUF, HF URL or USER/REPO')
        repo,rev,wanted=p
        if a.revision: rev=a.revision
        fs=hf_files(repo,rev); f=choose(fs,a.file or wanted); dl=shards(fs,f); mp=None if a.no_mmproj else mmproj(fs)
        if mp and mp not in dl: dl.append(mp)
        dst=MODELS_DIR/a.name; dst.mkdir(parents=True,exist_ok=True); hf_download(repo,rev,dl,dst)
        model=next((dst/x for x in sorted(dl) if '-00001-of-' in x), dst/f)
        mm=dst/mp if mp else None
    if not model.exists(): die(f'model missing after install: {model}')
    backup_ini(); txt=set_section(read_ini(),a.name,default_block(a.name,model,mm)); INI.write_text(txt,encoding='utf-8')
    st=load_state(); ms=st.setdefault('models',{}).setdefault(a.name,{})
    if not src.is_file():
        ms['hf']={'repo':repo,'revision':rev,'file':f}
    if a.ctx=='auto': ms.update({'ctx_mode':'auto','fit_ctx':a.fit_ctx}); ms.pop('ctx_size',None)
    else: ms.update({'ctx_mode':'fixed','ctx_size':int(a.ctx)}); ms.pop('fit_ctx',None); txt=set_key(read_ini(),a.name,'ctx-size',str(int(a.ctx))); INI.write_text(txt,encoding='utf-8')
    save_state(st)
    run([str(Path('/usr/local/bin/llama-hw-select'))], check=False)
    if not a.no_restart: restart()
def cmd_remove(a):
    txt=read_ini(); sec=get_section(txt,a.name)
    if not sec: die('profile not found')
    v=values(sec); backup_ini(); INI.write_text(remove_section(txt,a.name),encoding='utf-8')
    st=load_state(); st.setdefault('models',{}).pop(a.name,None); save_state(st)
    if a.files:
        p=Path(v.get('model',''))
        try: root=p.parent.resolve(); root.relative_to(MODELS_DIR.resolve())
        except Exception: root=None
        if root and root.is_dir(): shutil.rmtree(root); print('Removed:',root)
    if not a.no_restart: restart()
def cmd_ctx(a):
    txt=read_ini();
    if not get_section(txt,a.name): die('profile not found')
    st=load_state(); ms=st.setdefault('models',{}).setdefault(a.name,{})
    if a.value is None:
        print(json.dumps(ms or {'ctx_mode':'legacy'},indent=2)); return
    backup_ini()
    if a.value=='auto':
        ms={'ctx_mode':'auto','fit_ctx':a.fit_ctx}; st['models'][a.name]=ms
        txt=unset_key(txt,a.name,'ctx-size'); txt=set_key(txt,a.name,'fit-ctx',str(a.fit_ctx))
    else:
        try: n=int(a.value)
        except: die('ctx must be integer or auto')
        if n<=0: die('ctx must be > 0')
        ms={'ctx_mode':'fixed','ctx_size':n}; st['models'][a.name]=ms
        txt=unset_key(txt,a.name,'fit-ctx'); txt=set_key(txt,a.name,'ctx-size',str(n))
    INI.write_text(txt,encoding='utf-8'); save_state(st)
    if not a.no_restart: restart()
def cmd_set(a):
    if a.key.lower() in PROTECTED: die(f'{a.key} is boot-managed; use hardware auto-selection')
    if a.key.lower() in CACHE_KEYS and a.value.lower() not in CACHE_TYPES: print('WARNING: unusual cache type',file=sys.stderr)
    backup_ini(); INI.write_text(set_key(read_ini(),a.name,a.key,a.value),encoding='utf-8')
    if a.key.lower() in {'cache-type-k','cache-type-v','batch-size','ubatch-size'}:
        st=load_state(); ms=st.setdefault('models',{}).setdefault(a.name,{})
        if a.key.lower() in {'cache-type-k','cache-type-v'}:
            ms.setdefault('cache_pref',{})[a.key.lower()] = a.value
        else:
            ms.setdefault('perf_pref',{})[a.key.lower()] = a.value
        save_state(st)
    if not a.no_restart: restart()
def cmd_unset(a):
    if a.key.lower() in {'model','alias'}: die('refusing to remove required key')
    backup_ini(); INI.write_text(unset_key(read_ini(),a.name,a.key),encoding='utf-8')
    if a.key.lower() in {'cache-type-k','cache-type-v','batch-size','ubatch-size'}:
        st=load_state(); ms=st.setdefault('models',{}).setdefault(a.name,{})
        bucket='cache_pref' if a.key.lower() in {'cache-type-k','cache-type-v'} else 'perf_pref'
        pref=ms.get(bucket,{}); pref.pop(a.key.lower(),None)
        if not pref: ms.pop(bucket,None)
        save_state(st)
    if not a.no_restart: restart()
def cmd_backend(a):
    st=load_state(); hw=st.setdefault('hardware',{})
    if a.mode is None:
        print('backend =', hw.get('backend','auto'))
        if hw.get('device'): print('device =', hw['device'])
        print('profile =', hw.get('profile','balanced'))
        return
    mode=a.mode.lower()
    if mode not in BACKEND_MODES: die('backend must be auto, cuda, hip/rocm, vulkan or cpu')
    hw['backend']='rocm' if mode=='hip' else mode
    if a.device:
        hw['device']=a.device
    else:
        hw.pop('device',None)
    save_state(st)
    selector=Path('/usr/local/bin/llama-hw-select')
    if selector.exists(): run([selector])
    if not a.no_restart: restart()


def cmd_profile(a):
    st=load_state(); hw=st.setdefault('hardware',{})
    if a.profile is None:
        print(hw.get('profile','balanced')); return
    if a.profile not in PERF_PROFILES: die('profile must be balanced, throughput or capacity')
    hw['profile']=a.profile; save_state(st)
    selector=Path('/usr/local/bin/llama-hw-select')
    if selector.exists(): run([selector])
    if not a.no_restart: restart()


def _opencode_model_name(section, vals):
    alias=vals.get('alias','').strip()
    if alias and ',' not in alias and ' ' not in alias:
        return alias
    return section


def cmd_export_opencode(a):
    txt=read_ini(); st=load_state(); models={}
    warnings=[]
    for name in re.findall(r'(?m)^\[([^]]+)\]\s*$',txt):
        if name=='*': continue
        sec=get_section(txt,name); v=values(sec)
        if v.get('embeddings','').lower() in {'1','true','on','yes'} or v.get('reranking','').lower() in {'1','true','on','yes'}:
            continue
        if not v.get('model'): continue
        display_name=_opencode_model_name(name,v)
        ms=st.get('models',{}).get(name,{})
        if ms.get('ctx_mode')=='fixed':
            context=int(ms.get('ctx_size', v.get('ctx-size', 32768)))
        elif ms.get('ctx_mode')=='auto':
            # Conservative guaranteed minimum for auto-fit models.
            context=int(a.auto_context or ms.get('fit_ctx', v.get('fit-ctx', 4096)))
        else:
            context=int(v.get('ctx-size', v.get('fit-ctx', 32768)))
        output=int(v.get('n-predict', 8192))
        mm=v.get('mmproj')
        vision=False
        if mm:
            if Path(mm).exists(): vision=True
            else: warnings.append(f'{name}: mmproj missing: {mm}')
        models[name]={
            'modelID': name,
            'name': display_name,
            'capabilities': {
                'tools': True,
                'input': ['text','image'] if vision else ['text'],
                'output': ['text'],
            },
            'limit': {'context': context, 'output': output},
        }
    cfg={
        '$schema':'https://opencode.ai/config.json',
        'providers':{
            a.provider:{
                'name':a.name,
                'package':'@opencode/ai/providers/openai-compatible',
                'settings':{'baseURL':a.base_url.rstrip('/')},
                'models':models,
            }
        }
    }
    if a.default_model:
        if a.default_model not in models: die(f'default model not exported: {a.default_model}')
        cfg['model']=f'{a.provider}/{a.default_model}'
    out=json.dumps(cfg,indent=2,ensure_ascii=False)+'\n'
    if a.output:
        Path(a.output).expanduser().write_text(out,encoding='utf-8')
        print(f'Wrote {a.output} ({len(models)} models)')
    else:
        sys.stdout.write(out)
    for w in warnings: print('WARNING:',w,file=sys.stderr)



def _hf_sampling(repo, revision='main'):
    """Best-effort sampling defaults from HF generation_config.json or README."""
    try:
        from huggingface_hub import hf_hub_download
    except ImportError:
        die('install huggingface_hub: python3 -m pip install --user -U huggingface_hub')
    out={}
    # Prefer machine-readable generation config.
    try:
        gp=Path(hf_hub_download(repo_id=repo, filename='generation_config.json', revision=revision))
        g=json.loads(gp.read_text(encoding='utf-8'))
        mapping={'temperature':'temp','top_p':'top-p','top_k':'top-k','min_p':'min-p','presence_penalty':'presence-penalty','repetition_penalty':'repeat-penalty'}
        for src_key,dst_key in mapping.items():
            if src_key in g and g[src_key] is not None:
                out[dst_key]=str(g[src_key]).lower() if isinstance(g[src_key],bool) else str(g[src_key])
    except Exception:
        pass
    if out:
        return out,'generation_config.json'
    # Fall back to common model-card wording. Conservative: only parse explicit key/value pairs.
    try:
        rp=Path(hf_hub_download(repo_id=repo, filename='README.md', revision=revision))
        txt=rp.read_text(encoding='utf-8', errors='ignore')
        pats={
            'temp':[r'(?i)(?:temperature|temp)\s*[=:]\s*`?([0-9.]+)',r'(?i)temperature\s+of\s+`?([0-9.]+)'],
            'top-p':[r'(?i)top[_ -]?p\s*[=:]\s*`?([0-9.]+)'],
            'top-k':[r'(?i)top[_ -]?k\s*[=:]\s*`?([0-9]+)'],
            'min-p':[r'(?i)min[_ -]?p\s*[=:]\s*`?([0-9.]+)'],
            'presence-penalty':[r'(?i)presence[_ -]?penalty\s*[=:]\s*`?([0-9.]+)'],
            'repeat-penalty':[r'(?i)(?:repetition|repeat)[_ -]?penalty\s*[=:]\s*`?([0-9.]+)'],
        }
        for k,arr in pats.items():
            for pat in arr:
                m=re.search(pat,txt)
                if m:
                    out[k]=m.group(1); break
    except Exception:
        pass
    return out,'README.md' if out else None


def cmd_sampling(a):
    txt=read_ini(); sec=get_section(txt,a.name)
    if not sec: die('profile not found')
    v=values(sec); st=load_state(); ms=st.setdefault('models',{}).setdefault(a.name,{})
    if a.preset is None or a.preset=='show':
        current={k:v.get(k) for k in sorted(SAMPLING_KEYS) if k in v}
        print(json.dumps({'current':current,'preset':ms.get('sampling_preset'),'source':ms.get('sampling_source')},indent=2)); return
    preset=a.preset
    if preset=='hf':
        hf=ms.get('hf',{})
        repo=a.repo or hf.get('repo')
        rev=a.revision or hf.get('revision','main')
        if not repo: die('no Hugging Face source recorded; pass --repo USER/REPO')
        vals,source=_hf_sampling(repo,rev)
        if not vals: die(f'no explicit sampling defaults found in {repo}@{rev}')
        label='hf'; src=f'{repo}@{rev}:{source}'
    else:
        vals=SAMPLING_PRESETS[preset].copy(); label=preset; src='built-in fallback preset'
    backup_ini()
    for k,val in vals.items(): txt=set_key(txt,a.name,k,val)
    INI.write_text(txt,encoding='utf-8')
    ms['sampling_preset']=label; ms['sampling_source']=src; ms['sampling_values']=vals; save_state(st)
    print(f'{a.name}: sampling={label} ({src})')
    for k,val in vals.items(): print(f'  {k} = {val}')
    if not a.no_restart: restart()


def _device_for_bench():
    st=load_state(); hw=st.get('hardware',{}); pinned=hw.get('device')
    if pinned: return pinned
    try:
        r=run([str(SERVER),'--list-devices'],capture=True)
        lines=r.stdout.splitlines()
        mode=hw.get('backend','auto')
        preferred=[]
        if mode=='cuda' or mode=='auto': preferred += ['CUDA']
        if mode in {'rocm','hip'} or mode=='auto': preferred += ['ROCm']
        if mode=='vulkan' or mode=='auto': preferred += ['Vulkan']
        for prefix in preferred:
            for line in lines:
                m=re.match(r'\s*('+re.escape(prefix)+r'\d+):',line)
                if m: return m.group(1)
    except Exception: pass
    return 'auto'


def _bench_once(bench, model, device, cfg, prompt, gen, timeout, fit_target):
    cmd=[str(bench),'-m',str(model),'-p',str(prompt),'-n',str(gen),'-r','1','-o','json',
         '-b',str(cfg['batch']),'-ub',str(cfg['ubatch']),'-ctk',cfg['ctk'],'-ctv',cfg['ctv'],'-fa',cfg['fa']]
    if device == 'none':
        cmd += ['-ngl','0']
    else:
        cmd += ['-dev',device,'-fitt',str(fit_target)]
    try:
        cp=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout)
    except subprocess.TimeoutExpired:
        return None,'timeout'
    if cp.returncode!=0:
        return None,'failed'
    try: data=json.loads(cp.stdout)
    except Exception: return None,'bad-json'
    if isinstance(data,dict): data=[data]
    pp=tg=None
    for row in data:
        t=row.get('test') or row.get('test_name') or ''
        val=row.get('avg_ts') or row.get('avg_ts') or row.get('tokens_per_second')
        if val is None:
            # Current llama-bench JSON exposes avg_ts; older builds may expose samples.
            sm=row.get('samples_ts') or row.get('samples')
            if isinstance(sm,list) and sm: val=sum(map(float,sm))/len(sm)
        if val is None: continue
        if str(t).startswith('pp') or row.get('n_prompt',0): pp=float(val)
        if str(t).startswith('tg') or row.get('n_gen',0): tg=float(val)
    return {'pp':pp,'tg':tg},None


def cmd_tune(a):
    sec=get_section(read_ini(),a.name)
    if not sec: die('profile not found')
    v=values(sec); model=Path(v.get('model',''))
    if not model.is_file(): die(f'model file not found: {model}')
    bench=BUILD/'bin/llama-bench'
    if not bench.exists(): die(f'{bench} not found; run llama-modelctl update')
    # Adaptive budget by GGUF size; user may override.
    gib=model.stat().st_size/(1024**3)
    minutes=a.minutes
    if minutes is None:
        minutes=2 if gib<8 else 4 if gib<20 else 6 if gib<60 else 10
    budget=max(60,int(minutes*60)); deadline=datetime.datetime.now().timestamp()+budget
    device=a.device or _device_for_bench()
    backend='rocm' if device.startswith('ROCm') else 'cuda' if device.startswith('CUDA') else 'vulkan' if device.startswith('Vulkan') else 'cpu'
    hw=load_state().get('hardware',{}); prof=hw.get('profile','balanced')
    if backend=='rocm': fit_target=4096 if prof=='capacity' else 8192
    elif backend in {'cuda','vulkan'}: fit_target=768 if prof=='throughput' else 512 if prof=='capacity' else 1024
    else: fit_target=0
    # HX370/ROCm: F16 is mandatory policy. Else compare profile-compatible KV options.
    kvs=[('f16','f16')] if backend=='rocm' else [('q8_0','q8_0'),('f16','f16'),('q4_0','q4_0')]
    batches=[(128,128),(256,128),(512,256)]
    fas=['on','off']
    # Keep search bounded; throughput favors TG, capacity favors memory-safe configs, balanced combines PP/TG.
    candidates=[]
    for ctk,ctv in kvs:
        for b,ub in batches:
            for fa in fas:
                candidates.append({'batch':b,'ubatch':ub,'ctk':ctk,'ctv':ctv,'fa':fa})
    prompt=1024 if gib>60 else 2048
    gen=64 if gib>60 else 96
    results=[]
    print(f'Tuning {a.name}: {gib:.1f} GiB, device={device}, budget={minutes:g} min, candidates={len(candidates)}')
    for i,cfg in enumerate(candidates,1):
        remain=int(deadline-datetime.datetime.now().timestamp())
        if remain<20: break
        per=min(max(20,remain//max(1,len(candidates)-i+1)),90)
        print(f'[{i}/{len(candidates)}] b={cfg["batch"]} ub={cfg["ubatch"]} KV={cfg["ctk"]}/{cfg["ctv"]} FA={cfg["fa"]}')
        perf,err=_bench_once(bench,model,device,cfg,prompt,gen,per,fit_target)
        if perf:
            pp=perf.get('pp') or 0; tg=perf.get('tg') or 0
            if a.goal=='throughput': score=tg*0.8+pp*0.2/10
            elif a.goal=='capacity': score=tg*0.4+pp*0.6/10
            else: score=tg*0.65+pp*0.35/10
            results.append({**cfg,**perf,'score':score}); print(f'  pp={pp:.2f} tg={tg:.2f} score={score:.2f}')
        else: print(f'  skipped: {err}')
    if not results: die('no benchmark candidate completed successfully')
    results.sort(key=lambda x:x['score'],reverse=True); best=results[0]
    print('\nBest: '+json.dumps(best,indent=2))
    st=load_state(); ms=st.setdefault('models',{}).setdefault(a.name,{})
    fp=f'{backend}:{device}'
    ms.setdefault('tuning',{}).setdefault(fp,{})[a.goal]={'minutes':minutes,'best':best,'tested':results,'timestamp':datetime.datetime.now().isoformat(timespec='seconds')}
    save_state(st)
    if a.apply:
        backup_ini(); txt=read_ini()
        for k,val in [('batch-size',best['batch']),('ubatch-size',best['ubatch']),('flash-attn',best['fa']),('cache-type-k',best['ctk']),('cache-type-v',best['ctv'])]:
            txt=set_key(txt,a.name,k,str(val))
        INI.write_text(txt,encoding='utf-8')
        ms.setdefault('cache_pref',{})['cache-type-k']=best['ctk']; ms.setdefault('cache_pref',{})['cache-type-v']=best['ctv']
        ms.setdefault('perf_pref',{})['batch-size']=str(best['batch']); ms.setdefault('perf_pref',{})['ubatch-size']=str(best['ubatch']); save_state(st)
        print('Applied best measured performance settings to llama-models.ini')
        if not a.no_restart: restart()

def cmd_devices(a): run([str(SERVER),'--list-devices'])
def cmd_update(a):
    if not (REPO/'.git').exists(): die(f'{REPO} is not a git repo')
    requested={x.strip().lower() for x in a.backends.split(',') if x.strip()}
    if 'all' in requested: requested={'cuda','hip','vulkan'}
    requested={'hip' if x=='rocm' else x for x in requested}
    bad=requested-{'cuda','hip','vulkan','cpu'}
    if bad: die('unknown build backend(s): '+', '.join(sorted(bad)))
    run(['git','-C',REPO,'pull','--ff-only'])
    args=['cmake','-S',REPO,'-B',BUILD,'-G','Ninja','-DCMAKE_BUILD_TYPE=Release','-DGGML_BACKEND_DL=ON',
          f"-DGGML_CUDA={'ON' if 'cuda' in requested else 'OFF'}",
          f"-DGGML_HIP={'ON' if 'hip' in requested else 'OFF'}",
          f"-DGGML_VULKAN={'ON' if 'vulkan' in requested else 'OFF'}",
          '-DGGML_NATIVE=OFF']
    run(args); run(['cmake','--build',BUILD,'-j',str(os.cpu_count() or 4)])
    run([str(SERVER),'--list-devices'])
    if not a.no_restart: restart()

def main():
    p=argparse.ArgumentParser(prog='llama-modelctl'); sp=p.add_subparsers(dest='cmd',required=True)
    q=sp.add_parser('list'); q.set_defaults(func=cmd_list)
    q=sp.add_parser('show'); q.add_argument('name'); q.set_defaults(func=cmd_show)
    q=sp.add_parser('devices'); q.set_defaults(func=cmd_devices)
    q=sp.add_parser('backend'); q.add_argument('mode',nargs='?',choices=sorted(BACKEND_MODES)); q.add_argument('--device',help='exact device id, e.g. CUDA1 or Vulkan1'); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_backend)
    q=sp.add_parser('profile'); q.add_argument('profile',nargs='?',choices=sorted(PERF_PROFILES)); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_profile)
    q=sp.add_parser('add'); q.add_argument('name'); q.add_argument('source'); q.add_argument('--file'); q.add_argument('--revision'); q.add_argument('--mmproj'); q.add_argument('--no-mmproj',action='store_true'); q.add_argument('--ctx',default='auto'); q.add_argument('--fit-ctx',type=int,default=4096); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_add)
    q=sp.add_parser('remove'); q.add_argument('name'); q.add_argument('--files',action='store_true'); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_remove)
    q=sp.add_parser('ctx'); q.add_argument('name'); q.add_argument('value',nargs='?'); q.add_argument('--fit-ctx',type=int,default=4096); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_ctx)
    q=sp.add_parser('set'); q.add_argument('name'); q.add_argument('key'); q.add_argument('value'); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_set)
    q=sp.add_parser('unset'); q.add_argument('name'); q.add_argument('key'); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_unset)
    q=sp.add_parser('export-opencode'); q.add_argument('--base-url',required=True,help='remote llama-server OpenAI-compatible URL, e.g. http://192.168.1.50:8080/v1'); q.add_argument('--output','-o'); q.add_argument('--provider',default='llama-local'); q.add_argument('--name',default='llama.cpp'); q.add_argument('--default-model'); q.add_argument('--auto-context',type=int,help='context limit exported for auto-fit models; default is conservative fit-ctx minimum'); q.set_defaults(func=cmd_export_opencode)
    q=sp.add_parser('sampling'); q.add_argument('name'); q.add_argument('preset',nargs='?',choices=['show','hf',*sorted(SAMPLING_PRESETS)]); q.add_argument('--repo',help='HF repo override for preset=hf'); q.add_argument('--revision'); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_sampling)
    q=sp.add_parser('tune'); q.add_argument('name'); q.add_argument('--minutes',type=float,help='time budget; default adapts to model size'); q.add_argument('--goal',choices=['balanced','throughput','capacity'],default='balanced'); q.add_argument('--device',help='bench device override, e.g. CUDA0'); q.add_argument('--apply',action='store_true',help='apply the best measured performance settings'); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_tune)
    q=sp.add_parser('update'); q.add_argument('--backends',default='all',help='all or comma list: cuda,hip/rocm,vulkan,cpu'); q.add_argument('--no-restart',action='store_true'); q.set_defaults(func=cmd_update)
    a=p.parse_args(); a.func(a)
if __name__=='__main__': main()
